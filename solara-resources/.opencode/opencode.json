{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "agent": {
    "coder": {
      "description": "Primary Solara and PandasAI implementation agent",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.2,
      "maxTokens": 8000,
      "reasoningEffort": "medium",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true
      }
    },
    "architect": {
      "description": "Data architecture and PRD design agent",
      "mode": "subagent",
      "model": "anthropic/claude-opus-4-6",
      "temperature": 0.3,
      "maxTokens": 8000,
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "bash": false
      }
    },
    "analyst": {
      "description": "Data analysis and PandasAI query design agent",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.1,
      "maxTokens": 4000,
      "tools": {
        "read": true,
        "bash": true,
        "write": false
      }
    }
  },
  "providers": {
    "anthropic": {
      "apiKey": "${ANTHROPIC_API_KEY}"
    }
  }
}
